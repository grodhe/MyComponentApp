PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory
DB_USER=postgres
DB_PASSWORD=changeme
DB_SCHEMA=public

# Set to "false" to turn off login entirely -- for running this without
# a Synology NAS (e.g. a plain checkout from GitHub). Everyone gets in as
# a fixed local user, no DSM_*/SESSION_SECRET setup needed below.
# Defaults to "true" (login required) if unset.
AUTH_ENABLED=true

# Synology (DSM) login -- only used when AUTH_ENABLED=true. See
# Login_Setup_QA.md for details.
DSM_API_URL=https://192.168.1.50:5001
DSM_SESSION_NAME=HobbyistApp
DSM_VERIFY_SSL=false
DSM_ALLOWED_USERS=
SESSION_SECRET

# Component photo storage -- directory the app writes uploaded photos to.
# Must be a persistent Docker volume mount, or photos are lost on rebuild.
UPLOADS_DIR=
